# ---------------------------------------------------------------------------
# Montørappen – miljøvariabler
# Ingen av disse sendes til nettleseren. Legges inn i Vercel > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Påkrevd: hemmelighet som signerer innloggingsinformasjonen.
# Lag en ny med:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Tripletex ------------------------------------------------------------
# Uten disse kjører appen i demomodus med testdata.
TRIPLETEX_CONSUMER_TOKEN=
TRIPLETEX_EMPLOYEE_TOKEN=
# https://tripletex.no for produksjon, https://api-test.tripletex.tech for testmiljøet
TRIPLETEX_BASE_URL=https://api-test.tripletex.tech
# Selskapet kallene skal gjøres i. 0 = selskapet som eier ansattnøkkelen.
TRIPLETEX_COMPANY_ID=0

# --- Supabase -------------------------------------------------------------
# Uten disse lagres data bare i minnet (forsvinner ved omstart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (AI-utfylling av kontrollskjema) ---------------------------
ANTHROPIC_API_KEY=

# --- Kobbr ----------------------------------------------------------------
# Fylles ut hvis/når Kobbr bekrefter at de har et API.
KOBBR_API_KEY=
KOBBR_BASE_URL=
